# Port for the Hono server
PORT=3000

# SQLite database file path
DATABASE_URL=./data/domain-sentinel.sqlite

# Session JWT signing secret (long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# bcrypt hash of the login password. Generate with `pnpm hash-password`.
PASSWORD_HASH=

# Shared secret for the cron endpoint (Authorization: Bearer ...)
CRON_SECRET=change-me-to-a-long-random-string

# Session lifetime in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800
