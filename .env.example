# Port for the Hono server (listened on loopback only; cloudflared forwards to it)
PORT=3030

# SQLite database file path
DATABASE_URL=./data/domain-sentinel.sqlite

# Cloudflare Access configuration.
# Leave BOTH empty for local development (dev mode: all requests pass through).
# In production both MUST be set.
#   TEAM_DOMAIN: e.g. your-team.cloudflareaccess.com
#   AUD: the Application Audience (AUD) Tag from the Access application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Shared secret for the weekly cron endpoint (Authorization: Bearer ...)
# The endpoint is additionally gated to loopback-only (127.0.0.1/::1).
CRON_SECRET=change-me-to-a-long-random-string
